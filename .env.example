# Optional fallback. Prefer the in-app AI settings dialog: it saves your own key on this computer
# and applies without a restart. Values saved there take priority over this file.
# Providers: openai:<model> (default openai:gpt-6.1-sol) or anthropic:<model> (e.g. anthropic:claude-opus-5).
LOW_SKY_AGENT_MODEL=openai:gpt-6.1-sol
# Set the key for the chosen provider in the server environment; never commit a real key.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# For the offline, explicitly labelled rules baseline, set LOW_SKY_AGENT_MODEL="".
# The server loads these settings from the project .env at startup.
# Existing shell environment values take precedence over this file. Restart after changes.
