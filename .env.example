# OpenAI is the selected provider. The same model is the application default.
LOW_SKY_AGENT_MODEL=openai:gpt-6.1-sol
# Set OPENAI_API_KEY in the server environment; never commit a real key.
# OPENAI_API_KEY=
# For the offline, explicitly labelled rules baseline, set LOW_SKY_AGENT_MODEL="".
# The server loads these settings from the project .env at startup.
# Existing shell environment values take precedence. Restart after changes.
