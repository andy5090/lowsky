# Leave unset for the explicitly labelled deterministic rules baseline.
# To enable actual Deep Agents, install requirements-agent.txt plus the selected
# provider integration, then set provider:model and the provider's API key.
# No provider or paid model is selected by default.
# LOW_SKY_AGENT_MODEL=provider:model
# Set provider credentials in your shell or secret manager, never in git.
# The stdlib server does not automatically load .env files.
