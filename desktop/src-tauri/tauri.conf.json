{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LOW SKY",
  "version": "0.2.0",
  "identifier": "com.lowsky.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "title": "LOW SKY",
        "width": 640,
        "height": 320,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "LOW SKY simulation and decision workspace",
    "resources": {
      "payload/": "payload/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Korean"
        ],
        "displayLanguageSelector": true
      }
    }
  }
}
